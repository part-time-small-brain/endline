# copy to deploy/.env.testnet or deploy/.env.mainnet; each network is its own compose project (endline-<NETWORK_ID>)
# picks deploy/<NETWORK_ID>.json: the RPC, intents, options contract and quote asset come from there
NETWORK_ID=testnet
# testnet: proposer,ops (ops = the log viewer, one per host). mainnet: settler
COMPOSE_PROFILES=proposer,ops
# first three octets of the stack's private /24, different per stack: testnet 10.86.86, mainnet 10.86.87
SUBNET=10.86.86
# folder holding <NETWORK_ID>/<NAME>, one file per secret, written by the Infisical agent (deploy/infisical/agent-config.yaml): RELAYER_PRIVATE_KEY, MM_PRIVATE_KEY, MM_API_KEY, ORACLE_PRIVATE_KEY (testnet), SETTLER_PRIVATE_KEY (mainnet), TUNNEL_TOKEN, ALERT_WEBHOOK_URL, ONECLICK_JWT. Every file a started service uses must exist; an empty one means unset (only ALERT_WEBHOOK_URL and ONECLICK_JWT may be empty). Compose mounts them at /run/secrets and passes <NAME>_FILE, never the value
SECRETS_ROOT=C:/endline-secrets
RELAYER_ACCOUNT_ID=near-options-dev.testnet
# the proposer's oracle account (added with add_oracle); its full-access key is the ORACLE_PRIVATE_KEY secret (propose_settlement takes 1 yocto). No fallback to the relayer's: the proposer won't start without them
ORACLE_ACCOUNT_ID=oracle.near-options-dev.testnet
MM_ACCOUNT_ID=near-options-funder-1.testnet
# mainnet only, settler profile: SETTLER_ACCOUNT_ID=<settler>.near
# testnet only: the relayer sends 100 of the quote asset token into a user's intents balance on POST /faucet. Needs a full-access RELAYER_PRIVATE_KEY and the relayer holding the token. Leave out to turn it off
FAUCET=true
APP_ORIGINS=https://app.endline.trade
# HEALTH_URL=https://api.endline.trade/health (monitor uptime check; default http://web/health, inside compose)
# market maker and lister limits, see apps/mm/README.md (unset: the defaults). Mainnet POC: MAX_TRADE_USD=10 MAX_SERIES_USD=10 RESERVE_USD=10 MAX_DELTA_USD=500 MAX_VEGA_USD=20
# MAX_TRADE_USD=10
