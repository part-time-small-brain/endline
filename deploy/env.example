# picks deploy/<NETWORK_ID>.json: the RPC, intents, options contract and quote asset come from there
NETWORK_ID=testnet
RELAYER_ACCOUNT_ID=near-options-dev.testnet
RELAYER_PRIVATE_KEY=ed25519:...
# the proposer's oracle account (added with add_oracle) and its own full-access key (propose_settlement takes 1 yocto). No fallback to the relayer's: the proposer won't start without them
ORACLE_ACCOUNT_ID=oracle.near-options-dev.testnet
ORACLE_PRIVATE_KEY=ed25519:...
MM_ACCOUNT_ID=near-options-funder-1.testnet
MM_PRIVATE_KEY=ed25519:...
MM_API_KEYS=<same 16+ char key as MM_API_KEY>
# testnet only: the relayer sends 100 of the quote asset token into a user's intents balance on POST /faucet. Needs a full-access RELAYER_PRIVATE_KEY and the relayer holding the token. Leave out to turn it off
FAUCET=true
MM_API_KEY=<16+ char key>
APP_ORIGINS=https://app.endline.trade
# TUNNEL_TOKEN: the named tunnel's token from Zero Trust > Networks > Tunnels (routes api.endline.trade to http://web:80)
TUNNEL_TOKEN=...
# ONECLICK_JWT=<1Click Partner Portal JWT> (mainnet deposits: the relay sends it on /deposit-quote so users skip the +0.25% unauthenticated fee; leave out if unused, an empty value fails)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/... (Slack or Discord incoming webhook, or https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat id>; leave out if unused, an empty value fails)
# HEALTH_URL=https://api.endline.trade/health (monitor uptime check; default http://web/health, inside compose)
