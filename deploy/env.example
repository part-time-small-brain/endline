NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
INTENTS_ID=intents.near-options-dev.testnet
OPTIONS_ID=opt3.near-options-dev.testnet
QUOTE_ASSET=nep141:usdc.near-options-dev.testnet
RELAYER_ACCOUNT_ID=near-options-dev.testnet
RELAYER_PRIVATE_KEY=ed25519:...
# ORACLE_ACCOUNT_ID / ORACLE_PRIVATE_KEY: the proposer's oracle account and its full-access key (propose_settlement takes 1 yocto); defaults to the relayer's
MM_ACCOUNT_ID=near-options-funder-1.testnet
MM_PRIVATE_KEY=ed25519:...
MM_API_KEYS=<same 16+ char key as MM_API_KEY>
# testnet only: the relayer sends 100 of the QUOTE_ASSET token into a user's intents balance on POST /faucet. Needs a full-access RELAYER_PRIVATE_KEY and the relayer holding the token. Leave out to turn it off
FAUCET=true
MM_API_KEY=<16+ char key>
APP_ORIGINS=https://app.endline.trade
# TUNNEL_TOKEN: the named tunnel's token from Zero Trust > Networks > Tunnels (routes api.endline.trade to http://web:80)
TUNNEL_TOKEN=...
# ONECLICK_JWT=<1Click Partner Portal JWT> (mainnet deposits: the relay sends it on /deposit-quote so users skip the +0.25% unauthenticated fee; leave out if unused, an empty value fails)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/... (Slack or Discord incoming webhook; leave out if unused, an empty value fails)
# HEALTH_URL=https://api.endline.trade/health (monitor uptime check; default http://web/health, inside compose)
