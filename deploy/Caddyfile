{
	servers {
		trusted_proxies static 10.86.86.86/32
		client_ip_headers CF-Connecting-IP
	}
}

:80 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@relay path /health /series /marks /quote /publish /status/* /fills/* /execute /claims /calls /calls/* /leaderboard /leaderboard/* /faucet /deposit-quote
	handle @relay {
		reverse_proxy relay:8787 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		respond 404
	}
}
